# Shared environment for all tools in this workspace.
# Copy to `.env` in this folder (tools/.env, gitignored) and fill in what you use.
# Tools find it by walking up from their own folder; a tool-local `.env` overrides it.
# Add new variables here under the right section, prefixed with the tool/vendor name.

# ---------------------------------------------------------------- General
# Where open-source tools download model weights (shared cache across tools)
MODELS_DIR=./models
# Hugging Face token for gated models
HF_TOKEN=
# Default bind address for tool HTTP APIs; each tool may override with <TOOL>_PORT
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# ---------------------------------------------------------------- audio-gen / os
# KOKORO_PORT=8101
# VoiceStudio: upstream backend (voicestudio-backend) + our wrapper API/MCP. Paths are relative to tools/.
VOICESTUDIO_BACKEND_HOST=127.0.0.1
VOICESTUDIO_BACKEND_PORT=3900
# Use another backend instead (desktop app, GPU box); overrides host/port above
VOICESTUDIO_BACKEND_URL=
# Bearer key, only for a remote backend that requires one
VOICESTUDIO_BACKEND_API_KEY=
VOICESTUDIO_PORT=8103
VOICESTUDIO_MCP_PORT=8104
# Optional bearer token for the wrapper HTTP API
VOICESTUDIO_API_KEY=
# Defaults: audio-gen/os/voicestudio/{models,models/data,outputs}
# VOICESTUDIO_MODELS_DIR=
# VOICESTUDIO_DATA_DIR=
# VOICESTUDIO_OUTPUT_DIR=
# cuda | mps | cpu (empty = auto)
VOICESTUDIO_DEVICE=
# Per-request wait in seconds; covers the first-run ~2.3 GB model download
VOICESTUDIO_TIMEOUT_S=1800

# ---------------------------------------------------------------- audio-gen / custom

# ---------------------------------------------------------------- audio-gen / third-party
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- image-gen / os
# Z-Image-Turbo via mflux (MLX, Apple Silicon). Weights are downloaded + quantized on first use (or `zimage-prepare`).
# Bits for the local MLX copy: 8 (default), 6, 5, 4, 3, or bf16 for unquantized
ZIMAGE_QUANTIZE=8
# Defaults: image-gen/os/zimage/{models,outputs}; model path defaults to models/z-image-turbo-q<bits>
# ZIMAGE_MODELS_DIR=
# ZIMAGE_MODEL_PATH=
# ZIMAGE_OUTPUT_DIR=
# Keep the ~33 GB original HF download after quantizing (1 = keep; only needed to make other bit widths)
ZIMAGE_KEEP_DOWNLOAD=
# Free the model after this many idle seconds (0 = keep loaded)
ZIMAGE_IDLE_UNLOAD_S=900
# Cap on MLX's buffer cache in GB (0 = MLX default)
ZIMAGE_MLX_CACHE_LIMIT_GB=4
ZIMAGE_PORT=8130
ZIMAGE_MCP_PORT=8131
# Optional bearer token for the HTTP API
ZIMAGE_API_KEY=

# ---------------------------------------------------------------- video-gen / os
# LTX-2.5 via ltx-2-mlx (MLX, Apple Silicon). The pack is gated: accept the LTX-2.x license on its HF page and set
# HF_TOKEN above. Weights (~45 GB) are downloaded on first use (or `ltx-prepare`).
LTX_HF_REPO=dgrauet/ltx-2.5-mlx-q8
# Use a local pack folder instead of the HF download
# LTX_MODEL_PATH=
# Defaults: video-gen/os/ltx/{models,outputs}
# LTX_MODELS_DIR=
# LTX_OUTPUT_DIR=
# Stream transformer blocks from disk (1 = on; for Macs under 32 GB)
LTX_LOW_RAM=
# Free the pipeline after this many idle seconds (0 = keep loaded)
LTX_IDLE_UNLOAD_S=600
LTX_PORT=8140
LTX_MCP_PORT=8141
# Optional bearer token for the HTTP API
LTX_API_KEY=
# Wan 2.2 TI2V-5B via mlx-gen (MLX, Apple Silicon). Apache-2.0, not gated; ~18 GB downloaded on first use
# (or `wan-prepare`). Slow (~12 min per 5 s clip at 832x480), so clips run as background jobs.
WAN_HF_REPO=AbstractFramework/wan2.2-ti2v-5b-diffusers-8bit
# Use a local package folder instead of the HF download
# WAN_MODEL_PATH=
# Defaults: video-gen/os/wan/{models,outputs}
# WAN_MODELS_DIR=
# WAN_OUTPUT_DIR=
# Default denoising steps (4-50; 50 = Wan's reference quality, ~2x slower)
WAN_STEPS=25
WAN_PORT=8150
WAN_MCP_PORT=8151
# Optional bearer token for the HTTP API
WAN_API_KEY=

# ---------------------------------------------------------------- video-gen / custom

# ---------------------------------------------------------------- media / custom
# Localbox: LAN page that saves images and videos into a tagged folder. No auth.
# Listen on every interface so phones on the same network can open the page.
LOCALBOX_HOST=0.0.0.0
LOCALBOX_PORT=8120
# Comma-separated tag=path; relative paths resolve against the repo root. The page defaults to `comfy` when that tag exists.
LOCALBOX_DESTINATIONS=comfy=creative/os/creative-workflows/input
# Reject a single upload larger than this many megabytes.
LOCALBOX_MAX_MB=2048

# ---------------------------------------------------------------- creative / custom
# Comfyflow: runs ComfyUI workflows by name (CLI, HTTP API, MCP). Relative paths resolve against the repo root.
COMFYFLOW_COMFY_URL=http://127.0.0.1:8188
COMFYFLOW_COMFY_DIR=creative/os/creative-workflows
# Defaults to <COMFYFLOW_COMFY_DIR>/workflows/api
COMFYFLOW_WORKFLOWS_DIR=
COMFYFLOW_HOST=127.0.0.1
COMFYFLOW_PORT=8130
# Longest a blocking run waits, in seconds
COMFYFLOW_TIMEOUT_S=3600

# ---------------------------------------------------------------- video-gen / third-party
REPLICATE_API_TOKEN=
FAL_KEY=
RUNWAYML_API_SECRET=
LUMAAI_API_KEY=
